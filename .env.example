# Copy to .env and adjust. Every value is optional for local development.

# Set to 0 in production, together with a real secret key.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty for SQLite. Example for Postgres:
# DATABASE_URL=postgres://user:password@localhost:5432/fuel
DATABASE_URL=
