# Copy to .env and adjust. Every value is optional for local development.

# Set to 0 in production, together with a real secret key.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty for SQLite. For the Postgres in docker-compose.yml:
# DATABASE_URL=postgres://fuel:fuel@localhost:5432/fuel
DATABASE_URL=

# Routing servers, tried in order (comma-separated). Defaults to two free public OSRM servers.
# OSRM_SERVERS=https://router.project-osrm.org,https://routing.openstreetmap.de/routed-car
